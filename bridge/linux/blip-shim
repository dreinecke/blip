#!/usr/bin/env bash
# blip-shim — the Linux side of Blip's Mac bridge. Installed under three
# names (imsg, imsg-send, contacts); dispatches on its own basename and execs
# the matching tool on the Mac over ssh.
#
# iMessage is macOS-only: chat.db is TCC-protected and AppleScript send needs
# Messages.app, so every query and send proxies to the Mac. sshd on macOS
# inherits Full Disk Access + Automation consent (cron does not), which is
# what makes a plain ssh session a working transport.
#
# Config: ~/.config/blip/bridge.conf (written by scripts/blip-setup), sourced
# as shell — keys: host (ssh target), remote_bin (dir on the Mac holding the
# tools; default ~/.blip/bin), python (default python3).
#
# The connectivity probe MUST be `ssh -n`: a bare probe eats stdin and
# silently empties `imsg-send --file-stdin` payloads (learned the hard way).
set -euo pipefail

CONF="${BLIP_BRIDGE_CONF:-$HOME/.config/blip/bridge.conf}"
# remote_bin is expanded by the MAC's shell, so keep it literal here — a bare
# ~ or $HOME in bridge.conf would expand to the Linux home (it did).
host=""; remote_bin='$HOME/.blip/bin'; python="python3"
if [[ -r "$CONF" ]]; then
  # shellcheck disable=SC1090
  source "$CONF"
fi
host="${BLIP_MAC_HOST:-$host}"
if [[ -z "$host" ]]; then
  echo "blip: no Mac configured — run blip-setup (or set host= in $CONF)" >&2
  exit 78   # EX_CONFIG
fi

tool="$(basename "$0")"
case "$tool" in
  imsg|imsg-send|contacts|tcc-check|blip-check) ;;
  *) echo "blip-shim: unknown tool name '$tool' (install as imsg, imsg-send, or contacts)" >&2; exit 64 ;;
esac

if ! ssh -n -o ConnectTimeout=5 -o BatchMode=yes "$host" true 2>/dev/null; then
  echo "$tool: $host unreachable — the iMessage bridge is offline." >&2
  exit 69   # EX_UNAVAILABLE (Blip greys out on this code)
fi

# ${*@Q} quotes each argument for the remote shell: apostrophes, spaces,
# and leading dashes survive the double hop intact.
exec ssh "$host" "PATH=/opt/homebrew/bin:/usr/local/bin:\$PATH $python $remote_bin/$tool ${*@Q}"
