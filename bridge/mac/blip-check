#!/usr/bin/env python3
"""
blip-check: the three Mac permissions Blip needs, checked the way Blip uses them.

  python3 ~/.blip/bin/blip-check          # human lines, exit 0 when all pass
  python3 ~/.blip/bin/blip-check --json   # {"chatdb": bool, "automation": bool, "contacts": bool, ...}

Run it OVER SSH — that is the context that matters (sshd's grants, not the
Terminal's). The Automation check deliberately talks to Messages.app, which
makes macOS pop its one-time "sshd-keygen-wrapper wants to control Messages"
prompt on the Mac's screen if the grant is missing — click Allow once.
"""
from __future__ import annotations

import glob
import json
import os
import sqlite3
import subprocess
import sys

CHAT_DB = os.path.expanduser("~/Library/Messages/chat.db")
AB_GLOB = os.path.expanduser("~/Library/Application Support/AddressBook/Sources/*/AddressBook-v22.abcddb")

FIX = {
    "chatdb": "System Settings → Privacy & Security → Full Disk Access → add "
              "/usr/libexec/sshd-keygen-wrapper (⌘⇧G in the picker), then reconnect ssh.",
    "automation": "Click Allow on the Mac's screen when Messages asks, or: System Settings → "
                  "Privacy & Security → Automation → sshd-keygen-wrapper → Messages.",
    "contacts": "Same Full Disk Access grant as chat.db (names/avatars come from the AddressBook DB).",
}


def check_chatdb() -> tuple[bool, str]:
    try:
        con = sqlite3.connect(f"file:{CHAT_DB}?mode=ro", uri=True)
        n = con.execute("SELECT COUNT(*) FROM message").fetchone()[0]
        con.close()
        return True, f"{n} messages readable"
    except sqlite3.DatabaseError as e:
        return False, str(e)


def check_automation() -> tuple[bool, str]:
    # Touching Messages via AppleScript is what needs the grant — and what
    # triggers the prompt when it is missing. Listing services is harmless.
    try:
        r = subprocess.run(
            ["osascript", "-e", 'tell application "Messages" to get count of services'],
            capture_output=True, text=True, timeout=25,
        )
    except subprocess.TimeoutExpired:
        return False, "osascript timed out — the Allow prompt is probably waiting on the Mac's screen"
    if r.returncode == 0:
        return True, f"Messages responds ({r.stdout.strip()} services)"
    err = r.stderr.strip()
    if "-1743" in err or "not permitted" in err.lower() or "not authorized" in err.lower():
        return False, "Automation → Messages not granted"
    return False, err[:200]


def check_contacts() -> tuple[bool, str]:
    paths = glob.glob(AB_GLOB)
    if not paths:
        return False, "no AddressBook sources found"
    try:
        con = sqlite3.connect(f"file:{paths[0]}?mode=ro", uri=True)
        n = con.execute("SELECT COUNT(*) FROM ZABCDRECORD").fetchone()[0]
        con.close()
        return True, f"{n} contacts readable"
    except sqlite3.DatabaseError as e:
        return False, str(e)


def main() -> None:
    results = {"chatdb": check_chatdb(), "automation": check_automation(), "contacts": check_contacts()}
    if "--json" in sys.argv:
        print(json.dumps({k: {"ok": v[0], "detail": v[1], "fix": "" if v[0] else FIX[k]} for k, v in results.items()}))
    else:
        for k, (ok, detail) in results.items():
            print(f"  {'✅' if ok else '❌'}  {k:<10} {detail}")
            if not ok:
                print(f"      fix: {FIX[k]}")
    sys.exit(0 if all(v[0] for v in results.values()) else 1)


if __name__ == "__main__":
    main()
